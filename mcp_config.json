{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "mcpServers": {
    "meu-workspace-tools": {
      "command": "python",
      "args": [
        "-m",
        "mcp_servers.server"
      ],
      "env": {
        "PYTHONPATH": ".",
        "PYTHONUNBUFFERED": "1",
        "FASTMCP_SHOW_SERVER_BANNER": "false"
      },
      "description": "Servidor MCP Unificado via stdio para ferramentas do workspace e BigQuery"
    },
    "meu-workspace-sse": {
      "url": "http://127.0.0.1:8080/sse",
      "description": "Servidor MCP Unificado via SSE (porta 8080) para nuvem, contêineres e IDEs remotas"
    },
    "desktop-commander": {
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ]
    },
    "gdrive": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gdrive"
      ],
      "env": {
        "GDRIVE_CREDENTIALS_PATH": "C:/Users/melki/.gdrive-server-credentials.json"
      },
      "description": "Servidor MCP do Google Drive para navegação, busca e leitura de documentos"
    }
  }
}
