{
  "mcpServers": {
    "android-management-api": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://androidmanagement.googleapis.com/mcp"
    },
    "calendar": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://calendarmcp.googleapis.com/mcp/v1"
    },
    "chat": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://chatmcp.googleapis.com/mcp/v1"
    },
    "chrome-devtools-mcp": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "command": "npx"
    },
    "cloudrun": {
      "args": [
        "-y",
        "@google-cloud/cloud-run-mcp"
      ],
      "command": "npx"
    },
    "datacloud_alloydb_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://alloydb.googleapis.com/mcp"
    },
    "datacloud_bigquery_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://bigquery.googleapis.com/mcp"
    },
    "datacloud_cloud-sql_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://sqladmin.googleapis.com/mcp"
    },
    "datacloud_dataproc_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://dataproc-us-central1.googleapis.com/mcp"
    },
    "datacloud_gcs_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://storage.googleapis.com/storage/mcp"
    },
    "datacloud_knowledge_catalog_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://dataplex.googleapis.com/mcp"
    },
    "datacloud_spanner_remote": {
      "authProviderType": "google_credentials",
      "headers": {
        "User-Agent": "datacloud.antigravity"
      },
      "oauth": {},
      "serverUrl": "https://spanner.googleapis.com/mcp"
    },
    "desktop-commander": {
      "command": "node",
      "args": [
        "--no-warnings",
        "C:/Users/melki/.gemini/extensions/desktop-commander/dist/index.js"
      ]
    },
    "docs": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://docsmcp.googleapis.com/mcp/v1"
    },
    "drive": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://drivemcp.googleapis.com/mcp/v1"
    },
    "firebase-mcp-server": {
      "args": [
        "-y",
        "firebase-tools@latest",
        "mcp"
      ],
      "command": "npx"
    },
    "gemini-api-docs-mcp": {
      "serverUrl": "https://gemini-api-docs-mcp.dev"
    },
    "genkit-mcp-server": {
      "args": [
        "-y",
        "genkit-cli@^1.28.0",
        "mcp",
        "--explicitProjectRoot",
        "--no-update-notification",
        "--non-interactive"
      ],
      "command": "npx"
    },
    "github-mcp-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "gmail": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "gmp-code-assist": {
      "serverUrl": "https://mapscodeassist.googleapis.com/mcp"
    },
    "google-cloud-apigee-api-hub": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://apihub.googleapis.com/mcp"
    },
    "google-cloud-logging": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://logging.googleapis.com/mcp"
    },
    "google-cloud-resource-manager": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://cloudresourcemanager.googleapis.com/mcp"
    },
    "google-compute-engine": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://compute.googleapis.com/mcp"
    },
    "google-developer-knowledge": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://developerknowledge.googleapis.com/mcp"
    },
    "gopls-mcp-server": {
      "args": [
        "run",
        "golang.org/x/tools/gopls@latest",
        "mcp"
      ],
      "command": "go"
    },
    "people": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://people.googleapis.com/mcp/v1"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx",
      "env": {
        "NODE_NO_WARNINGS": "1"
      }
    },
    "sheets": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://sheetsmcp.googleapis.com/mcp/v1"
    },
    "slides": {
      "oauth": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "serverUrl": "https://slidesmcp.googleapis.com/mcp/v1"
    },
    "vertex-ai-search": {
      "authProviderType": "google_credentials",
      "serverUrl": "https://discoveryengine.googleapis.com/mcp"
    },
    "mdk-teste": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "tools.mcp_server"
      ],
      "cwd": "C:/Users/melki/mdk-teste"
    }
  }
}
