{
  "name": "code_intelligence_multi_turn",
  "description": "Dataset canônico multi-turn para avaliação de qualidade do Code Intelligence Agent no Quality Flywheel",
  "version": "1.5.0",
  "eval_cases": [
    {
      "eval_id": "case_01_ast_inspection_refactor",
      "description": "Inspeção AST e proposta de patch unificado para refatoração de bare except (BLE001)",
      "agent_data": {
        "agents": {
          "code_intelligence_agent": {
            "name": "code_intelligence_agent",
            "model": "gemini-3.8-flash"
          }
        },
        "turns": [
          {
            "turn_index": 0,
            "events": [
              {
                "author": "user",
                "content": {
                  "role": "user",
                  "parts": [
                    {
                      "text": "Por favor, analise a AST do arquivo calculator.py e aponte anomalias sintáticas ou estruturais."
                    }
                  ]
                }
              },
              {
                "author": "code_intelligence_agent",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "function_call": {
                        "name": "analyze_ast_anomalies",
                        "args": {
                          "file_path": "calculator.py"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "author": "tool",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "function_response": {
                        "name": "analyze_ast_anomalies",
                        "response": {
                          "status": "success",
                          "total_anomalies": 1,
                          "anomalies": [
                            {
                              "type": "bare_except",
                              "line": 15,
                              "message": "Cláusula bare 'except:' captura indiscriminadamente todas as exceções (BLE001)."
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "author": "code_intelligence_agent",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "text": "A análise AST revelou uma anomalia na linha 15: uma cláusula bare-except (BLE001) que deve ser refatorada para tratar exceções específicas."
                    }
                  ]
                }
              }
            ]
          },
          {
            "turn_index": 1,
            "events": [
              {
                "author": "user",
                "content": {
                  "role": "user",
                  "parts": [
                    {
                      "text": "Gere um patch unificado seguro para substituir 'except:' por 'except ValueError:' mantendo a sintaxe válida."
                    }
                  ]
                }
              },
              {
                "author": "code_intelligence_agent",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "function_call": {
                        "name": "generate_unified_patch",
                        "args": {
                          "file_path": "calculator.py",
                          "original_snippet": "        except:",
                          "replacement_snippet": "        except ValueError:"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "author": "tool",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "function_response": {
                        "name": "generate_unified_patch",
                        "response": {
                          "status": "applied",
                          "applied": true,
                          "changes_made": true,
                          "ast_validated": true
                        }
                      }
                    }
                  ]
                }
              },
              {
                "author": "code_intelligence_agent",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "text": "Patch gerado e validado com sucesso. A validação dry-run de AST confirmou que o código permanece sintaticamente íntegro após a substituição."
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
