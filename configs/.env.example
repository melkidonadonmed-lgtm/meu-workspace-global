# =====================================================================
# Variáveis de Ambiente do Ecossistema Global de Agentes
# =====================================================================

# Chave de API do Google Gemini (Obrigatório para Interactions API)
# Obtenha em: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# Modelo Padrão (Gemini Interactions API)
DEFAULT_MODEL=gemini-3.7-flash

# Configurações do Gateway FastAPI
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_RELOAD=true

# Configurações do Servidor FastMCP
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080
MCP_TRANSPORT=stdio # Opções: stdio, sse

# Nível de Log e Observabilidade
LOG_LEVEL=INFO
ENABLE_OPENTELEMETRY=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Configurações do Google Cloud Platform (GCP)
# Projeto oficial unificado do ecossistema: agent-md-506215
GCP_PROJECT_ID=agent-md-506215
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=configs/credentials.json

# Autenticação Google Workspace (OAuth 2.0 com Refresh Token permanente)
# Gerado via scripts/generate_oauth_refresh_token.py para melkidonadonmed@gmail.com
WORKSPACE_OAUTH_CLIENT_ID=seu_client_id.apps.googleusercontent.com
WORKSPACE_OAUTH_CLIENT_SECRET=seu_client_secret
WORKSPACE_OAUTH_REFRESH_TOKEN=seu_refresh_token
