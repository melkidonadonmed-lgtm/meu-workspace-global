# Ambiente de Execução (development, staging, production)
NODE_ENV=development
PORT=3000

# Chaves de API / Integrações Externas (placeholders)
API_BASE_URL=https://api.exemplo.com/v1
API_KEY=sua_chave_aqui_placeholder

# Banco de Dados / Persistência
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_banco

# Configurações de Autenticação
JWT_SECRET=seu_jwt_secret_temporario_para_dev
